:root {
  --navy: #0a2457;
  --navy2: #101c5d;
  --blue: #1077f8;
  --blue2: #2a95ff;
  --cyan: #42b8ff;
  --green: #12b76a;
  --red: #f04455;
  --orange: #f79009;
  --purple: #7a5af8;
  --teal: #0ba5a4;
  --ink: #102a56;
  --muted: #65758d;
  --line: #dde8f4;
  --bg: #f6f9fd;
  --panel: #fff;
  --shadow: 0 14px 40px rgba(34, 69, 118, .08);
  --soft-shadow: 0 8px 24px rgba(30, 74, 126, .06)
}

* {
  box-sizing: border-box
}

html {
  scroll-behavior: smooth
}

body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
  background: linear-gradient(180deg, #f8fbff 0, #f6f9fd 40%, #f8fbff 100%);
  color: var(--ink)
}

a {
  text-decoration: none;
  color: inherit
}

button,
input,
select {
  font: inherit
}

button {
  cursor: pointer
}

.app {
  min-height: 100vh
}

.muted {
  color: var(--muted)
}

/* shared brand / header */
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: max-content
}

.brand img {
  width: 44px;
  height: 44px
}

.brand strong {
  display: block;
  font-size: 22px;
  line-height: 1;
  color: #12265b
}

.brand small {
  display: block;
  color: #6d7d94;
  font-size: 11px;
  margin-top: 4px
}

.status-dot {
  display: inline-block;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 0 3px rgba(18, 183, 106, .11)
}

.searchbox {
  height: 40px;
  border: 1px solid #dce7f3;
  background: #f7faff;
  border-radius: 12px;
  padding: 0 14px;
  color: #6c7d95;
  outline: none
}

.searchbox:focus {
  border-color: #9fc9ff;
  box-shadow: 0 0 0 4px rgba(16, 119, 248, .08)
}

/* ADMIN */
.admin-shell {
  display: grid;
  grid-template-columns: 235px minmax(0, 1fr);
  min-height: 100vh
}

.sidebar {
  background: #fff;
  border-right: 1px solid var(--line);
  padding: 21px 14px;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow: auto;
  z-index: 30
}

.sidebar .brand {
  padding: 0 8px 22px
}

.side-nav {
  display: grid;
  gap: 5px
}

.side-nav a {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 12px 13px;
  border-radius: 12px;
  color: #314769;
  font-size: 14px;
  font-weight: 650;
  transition: .2s
}

.side-nav a:hover,
.side-nav a.active {
  background: linear-gradient(90deg, #e5f2ff, #eef6ff);
  color: #0875f5
}

.nav-ico {
  width: 22px;
  height: 22px;
  display: grid;
  place-items: center;
  font-weight: 900;
  color: #45607f
}

.side-nav a.active .nav-ico {
  color: #0875f5
}

.side-sep {
  height: 1px;
  background: #e7eef7;
  margin: 19px 2px
}

.side-label {
  font-size: 11px;
  color: #93a1b6;
  letter-spacing: .13em;
  font-weight: 800;
  margin: 0 10px 8px
}

.admin-main {
  min-width: 0
}

.admin-topbar {
  height: 62px;
  background: #fff;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 22px;
  position: sticky;
  top: 0;
  z-index: 25
}

.admin-topbar .searchbox {
  width: min(650px, 58vw)
}

.admin-profile {
  display: flex;
  align-items: center;
  gap: 11px;
  color: #2d4161;
  font-size: 12px
}

.admin-avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: linear-gradient(145deg, #e6efff, #f4f8ff);
  border: 1px solid #dce7f4;
  display: grid;
  place-items: center;
  font-weight: 800
}

.notification {
  position: relative;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #f7faff
}

.notification:after {
  content: "";
  width: 8px;
  height: 8px;
  background: #ef4444;
  border-radius: 50%;
  position: absolute;
  right: 4px;
  top: 4px;
  border: 2px solid #fff
}

.admin-content {
  max-width: 1500px;
  padding: 12px 18px 30px;
  margin: 0 auto
}

/* PUBLIC */
.public-header {
  height: 62px;
  background: #fff;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  padding: 0 32px;
  gap: 26px;
  position: sticky;
  top: 0;
  z-index: 30
}

.public-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  flex: 1
}

.public-nav a {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 10px 13px;
  border-radius: 11px;
  font-size: 12px;
  font-weight: 720;
  color: #293f66;
  white-space: nowrap
}

.public-nav a:hover,
.public-nav a.active {
  background: #e8f2ff;
  color: #075fe8
}

.public-actions {
  display: flex;
  align-items: center;
  gap: 10px
}

.public-actions .searchbox {
  width: 285px;
  border-radius: 999px
}

.public-content {
  max-width: 1500px;
  margin: auto;
  padding: 0 0 30px
}

/* HERO */
.hero {
  position: relative;
  overflow: hidden;
  background: #d8ecff;
  min-height: 236px;
  border-radius: 16px;
  box-shadow: var(--soft-shadow);
  border: 1px solid #d9e7f4
}

.public-content>.hero {
  border-radius: 0;
  min-height: 300px;
  border-left: 0;
  border-right: 0
}

.hero-bg {
  position: absolute;
  inset: 0;
  background-image: url('../img/campus-hero.jpg');
  background-size: cover;
  background-position: center right;
  transform: scale(1.015)
}

.hero:after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(251, 253, 255, .99) 0%, rgba(246, 251, 255, .95) 31%, rgba(238, 248, 255, .7) 48%, rgba(223, 240, 252, .18) 72%, rgba(6, 38, 72, .08) 100%)
}

.hero-copy {
  position: relative;
  z-index: 2;
  padding: 29px 34px;
  max-width: 700px
}

.public-content>.hero .hero-copy {
  padding: 34px 46px;
  max-width: 760px
}

.eyebrow {
  font-size: 12px;
  letter-spacing: .13em;
  color: #355e8c;
  font-weight: 800
}

.hero h1 {
  margin: 8px 0 8px;
  font-size: 39px;
  line-height: 1.05;
  letter-spacing: -.035em;
  color: #0d1f63
}

.public-content>.hero h1 {
  font-size: 47px
}

.hero .accent {
  color: #135bea
}

.hero p {
  font-size: 15px;
  color: #536a87;
  line-height: 1.5;
  margin: 0;
  max-width: 630px
}

.hero-chips {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-top: 19px
}

.hero-chip {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 700;
  color: #1d3154
}

.chip-icon {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #e4f1ff;
  color: #1371ef
}

.chip-icon.green {
  background: #ddfaed;
  color: #07a85e
}

.chip-icon.purple {
  background: #eee8ff;
  color: #7a5af8
}

.hero-status {
  position: absolute;
  right: 20px;
  top: 18px;
  z-index: 3;
  background: rgba(255, 255, 255, .92);
  padding: 9px 13px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  box-shadow: var(--soft-shadow);
  display: flex;
  align-items: center;
  gap: 7px
}

.hero-clock {
  position: absolute;
  right: 26px;
  top: 63px;
  z-index: 3;
  text-align: right;
  color: #12265b
}

.hero-clock small {
  display: block;
  font-size: 11px
}

.hero-clock b {
  font-size: 25px
}

.hero-clock span {
  font-size: 12px;
  margin-left: 5px
}

/* cards */
.stats {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 11px;
  margin: 13px 0
}

.stats.public-five {
  grid-template-columns: repeat(5, minmax(0, 1fr));
  padding: 0 24px;
  margin-top: 14px
}

.stat-card {
  background: #fff;
  border: 1px solid #e1ebf5;
  border-radius: 15px;
  padding: 14px 14px;
  box-shadow: var(--soft-shadow);
  min-height: 108px;
  position: relative;
  overflow: hidden
}

.stat-card::after {
  content: "";
  position: absolute;
  width: 100px;
  height: 100px;
  border-radius: 50%;
  right: -48px;
  bottom: -55px;
  background: currentColor;
  opacity: .04
}

.stat-top {
  display: flex;
  gap: 10px;
  align-items: center
}

.stat-icon {
  width: 42px;
  height: 42px;
  border-radius: 13px;
  display: grid;
  place-items: center;
  font-size: 21px;
  background: #e7f2ff;
  color: #0875f5
}

.stat-card.green .stat-icon {
  background: #def8ec;
  color: #0cad66
}

.stat-card.red .stat-icon {
  background: #ffe6e9;
  color: #e5283d
}

.stat-card.purple .stat-icon {
  background: #eee8ff;
  color: #7550ec
}

.stat-card.orange .stat-icon {
  background: #fff0df;
  color: #ef7d00
}

.stat-card.teal .stat-icon {
  background: #dff8f7;
  color: #0aa09d
}

.stat-label {
  font-size: 11px;
  color: #5b6e88
}

.stat-value {
  font-size: 24px;
  font-weight: 850;
  letter-spacing: -.03em;
  color: #0d2354;
  margin-top: 2px
}

.stat-foot {
  font-size: 10px;
  color: #70829a;
  margin-top: 8px
}

.up {
  color: #0ca862;
  font-weight: 800
}

.down {
  color: #e94455;
  font-weight: 800
}

/* panels and grids */
.grid {
  display: grid;
  gap: 12px
}

.grid.two {
  grid-template-columns: 1.65fr .75fr
}

.grid.two-even {
  grid-template-columns: 1fr 1fr
}

.grid.three {
  grid-template-columns: 1.05fr .95fr .8fr
}

.grid.public-main {
  padding: 0 24px;
  grid-template-columns: 1.55fr .82fr .72fr
}

.section-pad {
  padding: 0 24px
}

.panel {
  background: #fff;
  border: 1px solid #e0eaf4;
  border-radius: 16px;
  padding: 14px;
  box-shadow: var(--soft-shadow);
  min-width: 0
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 10px
}

.panel-title {
  font-size: 15px;
  font-weight: 850;
  color: #10295b;
  display: flex;
  align-items: center;
  gap: 8px
}

.panel-sub {
  font-size: 10px;
  color: #8190a4
}

.tiny-select {
  height: 31px;
  border: 1px solid #dbe6f1;
  background: #fff;
  border-radius: 8px;
  color: #536682;
  font-size: 10px;
  padding: 0 9px
}

.link-button {
  border: 0;
  background: #eaf4ff;
  color: #0875f5;
  border-radius: 9px;
  padding: 8px 10px;
  font-size: 10px;
  font-weight: 800
}

.divider {
  height: 1px;
  background: #edf2f7;
  margin: 10px 0
}

/* charts */
.chart {
  height: 230px;
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  background: linear-gradient(180deg, #fff, #fbfdff)
}

.chart.small {
  height: 170px
}

.chart-grid {
  position: absolute;
  inset: 12px 5px 26px 32px;
  background: repeating-linear-gradient(to bottom, transparent 0, transparent 39px, #edf2f7 40px), repeating-linear-gradient(to right, transparent 0, transparent 85px, #edf2f7 86px)
}

.chart svg {
  position: absolute;
  inset: 9px 6px 26px 31px;
  width: calc(100% - 37px);
  height: calc(100% - 35px);
  overflow: visible
}

.axis {
  position: absolute;
  left: 33px;
  right: 8px;
  bottom: 4px;
  display: flex;
  justify-content: space-between;
  color: #73849a;
  font-size: 9px
}

.legend {
  display: flex;
  gap: 12px;
  align-items: center;
  font-size: 9px;
  color: #52657e
}

.legend i {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  display: inline-block;
  margin-right: 5px
}

.chart-note {
  position: absolute;
  left: 12px;
  top: 6px;
  font-size: 9px;
  color: #73849a
}

.bar-chart {
  display: flex;
  align-items: end;
  gap: 7px;
  height: 140px;
  padding: 16px 10px 20px;
  border-left: 1px solid #edf2f7;
  border-bottom: 1px solid #edf2f7
}

.bar-chart span {
  flex: 1;
  background: linear-gradient(180deg, #78b9ff, #1f84f7);
  border-radius: 4px 4px 0 0;
  min-width: 6px
}

.donut {
  width: 152px;
  height: 152px;
  border-radius: 50%;
  background: conic-gradient(#318ef6 0 38%, #f85d70 38% 59.5%, #3bcf91 59.5% 74.6%, #865ff5 74.6% 85.7%, #ffc248 85.7% 93%, #8fc7ff 93% 100%);
  position: relative;
  margin: auto
}

.donut::after {
  content: "";
  position: absolute;
  inset: 34px;
  background: #fff;
  border-radius: 50%
}

.donut-center {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: grid;
  place-content: center;
  text-align: center
}

.donut-center b {
  font-size: 19px
}

.donut-center small {
  font-size: 9px;
  color: #72839a
}

/* tables */
.table-tools {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
  margin: 4px 0 10px
}

.table-tools .searchbox {
  flex: 1;
  min-width: 210px;
  height: 35px
}

.table-wrap {
  overflow: auto;
  border-radius: 10px
}

.table {
  width: 100%;
  border-collapse: collapse;
  font-size: 10px
}

.table thead {
  background: #f0f5fa
}

.table th {
  font-weight: 750;
  color: #52657f;
  text-align: left;
  padding: 8px 9px;
  white-space: nowrap
}

.table td {
  padding: 8px 9px;
  border-bottom: 1px solid #edf2f7;
  white-space: nowrap;
  color: #405570
}

.table tr:hover td {
  background: #fbfdff
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  border-radius: 999px;
  padding: 4px 8px;
  font-size: 9px;
  font-weight: 800
}

.badge.ok {
  background: #ddf8ea;
  color: #0b9b5b
}

.badge.bad {
  background: #ffe3e7;
  color: #dc3448
}

.badge.warn {
  background: #fff1d9;
  color: #c97700
}

.badge.blue {
  background: #e4f0ff;
  color: #1766d7
}

.badge.purple {
  background: #eee8ff;
  color: #6e4be3
}

.badge.gray {
  background: #eef2f6;
  color: #637389
}

.badge.pink {
  background: #ffe8f1;
  color: #cf3d79
}

.badge.orange {
  background: #fff0df;
  color: #d36e00
}

.action-icon {
  border: 0;
  width: 27px;
  height: 27px;
  border-radius: 8px;
  background: #eaf4ff;
  color: #0875f5
}

.action-icon.danger {
  background: #fff0f1;
  color: #e13a4c
}

.pagination {
  display: flex;
  gap: 4px;
  justify-content: flex-end;
  margin-top: 10px
}

.pagination span {
  width: 28px;
  height: 28px;
  border: 1px solid #dfe8f3;
  border-radius: 7px;
  display: grid;
  place-items: center;
  font-size: 10px;
  color: #55677f
}

.pagination .active {
  background: #0b7cf6;
  color: #fff;
  border-color: #0b7cf6
}

/* lists */
.ranking {
  display: grid;
  gap: 8px
}

.rank-row {
  display: grid;
  grid-template-columns: minmax(120px, 1fr) 42% 46px;
  align-items: center;
  gap: 9px;
  font-size: 10px
}

.rank-name {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0
}

.brand-dot {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 11px;
  background: #f2f6fb
}

.progress {
  height: 9px;
  background: #edf2f7;
  border-radius: 999px;
  overflow: hidden
}

.progress i {
  display: block;
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #4da4ff, #8dc8ff)
}

.progress.red i {
  background: linear-gradient(90deg, #ff6475, #ff94a1)
}

.progress.green i {
  background: linear-gradient(90deg, #31c68a, #7adcb0)
}

.progress.purple i {
  background: linear-gradient(90deg, #815ef5, #b79fff)
}

.kv-list {
  display: grid;
  gap: 7px
}

.kv-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid #edf2f7;
  font-size: 10px
}

.kv-row:last-child {
  border-bottom: 0
}

.device-row {
  display: grid;
  grid-template-columns: 36px 1fr auto;
  gap: 8px;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid #edf2f7
}

.device-icon {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: #eaf3ff;
  display: grid;
  place-items: center;
  color: #0f72ec
}

.device-row b {
  font-size: 10px
}

.device-row small {
  display: block;
  font-size: 9px;
  color: #7a8ba0;
  margin-top: 2px
}

/* admin special */
.resource-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px
}

.resource {
  background: #fbfdff;
  border: 1px solid #edf3f8;
  border-radius: 11px;
  padding: 10px
}

.resource b {
  font-size: 11px
}

.resource .big {
  font-size: 18px;
  margin: 5px 0;
  font-weight: 850
}

.policy-list {
  display: grid;
  gap: 7px
}

.policy {
  display: grid;
  grid-template-columns: 34px 1fr auto;
  gap: 9px;
  align-items: center;
  padding: 7px 0;
  border-bottom: 1px solid #edf2f7
}

.policy:last-child {
  border-bottom: 0
}

.policy .picon {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  background: #eaf4ff;
  display: grid;
  place-items: center
}

.switch {
  width: 35px;
  height: 19px;
  border-radius: 999px;
  background: #c8d3e0;
  position: relative
}

.switch::after {
  content: "";
  position: absolute;
  width: 15px;
  height: 15px;
  border-radius: 50%;
  background: #fff;
  top: 2px;
  left: 2px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, .15)
}

.switch.on {
  background: #14b86a
}

.switch.on::after {
  left: 18px
}

.insights {
  display: grid;
  gap: 8px
}

.insight {
  display: grid;
  grid-template-columns: 38px 1fr 16px;
  gap: 9px;
  align-items: center;
  padding: 9px;
  border-radius: 11px;
  background: #ecfff4
}

.insight.red {
  background: #fff0f2
}

.insight.blue {
  background: #eef6ff
}

.insight.purple {
  background: #f5f0ff
}

.insight .iicon {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: rgba(255, 255, 255, .9);
  display: grid;
  place-items: center
}

.insight b {
  font-size: 10px
}

.insight small {
  display: block;
  color: #66778e;
  font-size: 9px
}

/* public */
.public-hero-kicker {
  padding: 0 24px
}

.public-body {
  padding: 0 24px
}

.public-promo {
  min-height: 225px;
  background-image: linear-gradient(90deg, rgba(234, 245, 255, .98), rgba(234, 245, 255, .55)), url('../img/campus-promo.jpg');
  background-size: cover;
  background-position: center;
