/* ===== V4 ADMIN FIXED SIDEBAR =====
   Desktop: sidebar stays pinned while only the main page content scrolls.
   This mirrors the intended future Blade layout: fixed sidebar + sticky topbar + scrollable content.
*/
@media (min-width:901px) {
  .admin-shell {
    display: block;
    min-height: 100vh;
  }

  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: 235px;
    height: 100vh;
    z-index: 50;
    border-right: 1px solid var(--line);
    background: #fff;
    padding: 16px 14px 14px;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  .sidebar::-webkit-scrollbar {
    width: 0;
    height: 0;
    display: none
  }

  .sidebar .brand {
    padding: 0 8px 16px
  }

  .side-nav {
    gap: 3px
  }

  .side-nav a {
    padding: 10px 12px;
    min-height: 42px
  }

  .side-sep {
    margin: 13px 2px
  }

  .side-label {
    margin: 0 10px 6px
  }

  .admin-main {
    margin-left: 235px;
    width: calc(100% - 235px);
    min-width: 0;
    min-height: 100vh;
  }

  .admin-topbar {
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .admin-content {
    min-height: calc(100vh - 62px - 60px);
  }
}

/* Tablet/mobile: return sidebar to normal flow so the layout remains usable. */
@media (max-width:900px) {
  .admin-shell {
    display: block
  }

  .sidebar {
    position: relative;
    inset: auto;
    width: 100%;
    height: auto;
    max-height: none;
    overflow: visible;
    border-right: 0;
  }

  .admin-main {
    margin-left: 0;
    width: 100%;
  }
}