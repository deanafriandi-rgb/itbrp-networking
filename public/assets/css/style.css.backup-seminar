/* ===== V3 LAYOUT CONSISTENCY / BLADE-READY OVERRIDES ===== */
html,
body {
  max-width: 100%;
  overflow-x: hidden
}

body {
  min-width: 0
}

.admin-main,
.admin-content,
.public-content,
.panel,
.grid>* {
  min-width: 0
}

.admin-content,
.public-content {
  width: 100%;
  overflow-x: hidden
}

.table-wrap {
  max-width: 100%;
  overflow-x: auto;
  overscroll-behavior-inline: contain
}

.table {
  min-width: 760px
}

.panel {
  overflow: hidden
}

.panel .table-wrap {
  overflow: auto
}

.stat-top>div:last-child {
  min-width: 0
}

.stat-label,
.stat-value,
.stat-foot {
  overflow-wrap: anywhere
}

.stat-value {
  line-height: 1.05
}

.grid {
  min-width: 0
}

.grid.three {
  grid-template-columns: repeat(3, minmax(0, 1fr))
}

.grid.two,
.grid.two-even {
  min-width: 0
}

.admin-search-wrap {
  flex: 1;
  min-width: 0;
  max-width: 720px
}

.admin-topbar {
  gap: 18px
}

.admin-topbar .searchbox {
  width: 100%;
  max-width: 680px
}

.admin-profile-link {
  padding: 7px 9px;
  border-radius: 12px;
  transition: .2s
}

.admin-profile-link:hover {
  background: #f4f8fd
}

.admin-avatar {
  flex: 0 0 auto
}

.admin-footer {
  padding: 20px 26px 28px;
  border-top: 1px solid #e9eff6;
  margin-top: 10px;
  background: transparent
}

.sidebar {
  overflow-x: hidden
}

.side-nav a {
  min-width: 0
}

.side-nav a .badge {
  flex: 0 0 auto
}

/* Public header is intentionally simpler than V2: navigation only. Search is in a separate utility row. */
.public-header {
  height: 68px;
  padding: 0 22px;
  gap: 0
}

.public-header-inner {
  width: 100%;
  max-width: 1500px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 20px
}

.public-header .brand img {
  width: 40px;
  height: 40px
}

.public-header .brand strong {
  font-size: 20px
}

.public-nav {
  min-width: 0;
  gap: 3px;
  overflow-x: auto;
  scrollbar-width: none;
  justify-content: center
}

.public-nav::-webkit-scrollbar {
  display: none
}

.public-nav a {
  padding: 9px 10px;
  font-size: 11.5px
}

.public-profile-link {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid #e1eaf4;
  background: #f8fbff;
  border-radius: 999px;
  padding: 5px 9px 5px 6px;
  color: #243d63;
  white-space: nowrap
}

.public-profile-link:hover {
  background: #edf6ff;
  border-color: #cfe2f8
}

.public-profile-text {
  display: grid;
  line-height: 1.05
}

.public-profile-text b {
  font-size: 10px
}

.public-profile-text small {
  font-size: 9px;
  color: #77889e;
  margin-top: 3px
}

.public-toolbar {
  background: #fff;
  border-bottom: 1px solid #e5edf6
}

.public-toolbar-inner {
  max-width: 1500px;
  margin: 0 auto;
  min-height: 50px;
  padding: 6px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px
}

.public-toolbar-status {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #667a94;
  font-size: 10px;
  font-weight: 700
}

.public-search {
  width: min(470px, 45vw);
  border-radius: 999px;
  background: #f6f9fd
}

.public-content>.hero {
  margin-top: 0
}

.public-content {
  padding-bottom: 0
}

.footer {
  border-top: 1px solid #e7eef6;
  margin-top: 20px;
  background: #fff
}

/* Statistics cards auto-fit instead of squeezing/offside text. */
.stats {
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  align-items: stretch
}

.stats.public-five {
  grid-template-columns: repeat(auto-fit, minmax(185px, 1fr));
  padding: 0 24px
}

.stat-card {
  min-width: 0;
  min-height: 110px
}

.stat-top {
  align-items: flex-start
}

.stat-icon {
  flex: 0 0 42px
}

.stat-value {
  font-size: clamp(20px, 1.75vw, 25px)
}

/* Status pages: use two balanced columns, never three narrow/offside cards. */
.status-grid-two {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px
}

.alert-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 8px
}

.alert-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 11px;
  border: 1px solid #edf2f7;
  border-radius: 10px;
  background: #fbfdff;
  font-size: 10px;
  color: #4d627f
}

.failopen-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
  gap: 14px;
  align-items: start;
  margin-top: 12px
}

/* Profile */
.profile-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
  gap: 12px
}

.public-profile-grid {
  margin-top: 12px
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 22px;
  min-height: 220px;
  background: linear-gradient(135deg, #ffffff 0%, #f3f8ff 100%)
}

.profile-avatar-xl {
  width: 116px;
  height: 116px;
  flex: 0 0 116px;
  border-radius: 30px;
  display: grid;
  place-items: center;
  font-size: 38px;
  font-weight: 900;
  color: #fff;
  background: linear-gradient(145deg, #1176f4, #6f55f6);
  box-shadow: 0 18px 38px rgba(35, 105, 220, .2)
}

.profile-identity h2 {
  font-size: 30px;
  line-height: 1.05;
  margin: 10px 0 7px;
  color: #0c2456
}

.profile-identity p,
.profile-copy {
  font-size: 12px;
  line-height: 1.7;
  color: #637792;
  margin: 0
}

.profile-meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
  margin-top: 16px
}

.profile-meta span {
  display: flex;
  flex-direction: column;
  gap: 4px;
  border: 1px solid #e4edf6;
  border-radius: 11px;
  padding: 10px;
  background: #fff;
  font-size: 9px;
  color: #66788e
}

.profile-meta b {
  font-size: 9px;
  color: #173563
}

.profile-feature-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
  margin-top: 14px
}

.profile-feature-grid>div {
  border: 1px solid #e3edf7;
  background: #f8fbff;
  border-radius: 12px;
  padding: 12px;
  display: grid;
  gap: 5px
}

.profile-feature-grid b {
  font-size: 11px;
  color: #18376a
}

.profile-feature-grid span {
  font-size: 9px;
  line-height: 1.45;
  color: #6a7c93
}

.profile-kv .kv-row {
  grid-template-columns: minmax(120px, .65fr) minmax(0, 1.35fr);
  align-items: start
}

.profile-kv b {
  text-align: right;
  white-space: normal
}

.timeline {
  display: grid;
  gap: 11px;
  margin-top: 14px
}

.timeline>div {
  display: grid;
  grid-template-columns: 30px 1fr;
  gap: 10px;
  align-items: start
}

.timeline i {
  width: 28px;
  height: 28px;
  border-radius: 9px;
  background: #e7f2ff;
  color: #0875f5;
  display: grid;
  place-items: center;
  font-style: normal;
  font-weight: 900;
  font-size: 10px
}

.timeline span {
  font-size: 10px;
  line-height: 1.5;
  color: #61738d
}

.timeline b {
  display: block;
  color: #193766;
  margin-bottom: 2px
}

/* Hero and content sizing: consistent on every page. */
.admin-content>.hero {
  margin-bottom: 13px
}

.public-content>.hero .hero-copy {
  max-width: 720px
}

.hero-copy {
