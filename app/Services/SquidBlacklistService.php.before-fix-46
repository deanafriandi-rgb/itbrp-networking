<?php

namespace App\Services;

use App\Models\BlacklistDomain;
use Illuminate\Support\Facades\File;
use RuntimeException;
use Throwable;

class SquidBlacklistService
{
    /**
     * Mengambil lokasi blacklist dari config/squid.php.
     */
    public function getBlacklistPath(): string
    {
        $path = (string) config(
            'squid.blacklist_file'
        );

        if (trim($path) === '') {
            throw new RuntimeException(
                'Path blacklist Squid belum dikonfigurasi.'
            );
        }

        return $path;
    }

    /**
     * Mengambil domain blacklist aktif dari database,
     * kemudian mengubahnya menjadi format file Squid.
     *
     * PENTING:
     * Satu record database menghasilkan SATU rule Squid.
     *
     * include_subdomains = true:
     * facebook.com -> .facebook.com
     *
     * include_subdomains = false:
     * facebook.com -> facebook.com
     */
    public function buildBlacklist(): array
    {
        $domains = BlacklistDomain::query()
            ->where('is_active', true)
            ->orderBy('category')
            ->orderBy('domain')
            ->get();

        $invalidDomains = [];

        /*
        |--------------------------------------------------------------------------
        | Kelompok rule berdasarkan kategori
        |--------------------------------------------------------------------------
        |
        | Komentar kategori tetap dipertahankan supaya blacklist.txt mudah
        | dibaca dan halaman Blade dapat menampilkan kategori:
        |
        | # FACEBOOK
        | .facebook.com
        | .facebook.net
        |
        */

        $groups = [];

        foreach ($domains as $item) {
            $domain = $this->normalizeDomain(
                $item->domain
            );

            if ($domain === null) {
                $invalidDomains[] =
                    (string) $item->domain;

                continue;
            }

            $category = trim(
                (string) (
                    $item->category
                    ?? ''
                )
            );

            if ($category === '') {
                $category = 'LAINNYA';
            }

            $category = strtoupper(
                $category
            );

            /*
            |--------------------------------------------------------------------------
            | SATU DB ROW = SATU RULE
            |--------------------------------------------------------------------------
            */

            $rule =
                $item->include_subdomains
                    ? '.' . $domain
                    : $domain;

            if (!isset($groups[$category])) {
                $groups[$category] = [];
            }

            $groups[$category][] =
                $rule;
        }

        if (!empty($invalidDomains)) {
            throw new RuntimeException(
                'Domain blacklist tidak valid: '
                . implode(
                    ', ',
                    $invalidDomains
                )
            );
        }

        /*
        |--------------------------------------------------------------------------
        | Rapikan kategori dan rule
        |--------------------------------------------------------------------------
        */

        ksort(
            $groups,
            SORT_NATURAL
                | SORT_FLAG_CASE
        );

        $lines = [];
        $ruleLines = [];

        foreach ($groups as $category => $rules) {
            $rules = array_values(
                array_unique($rules)
            );

            sort(
                $rules,
                SORT_NATURAL
                    | SORT_FLAG_CASE
            );

            if (empty($rules)) {
                continue;
            }

            $lines[] =
                '# ' . $category;

            foreach ($rules as $rule) {
                /*
                |--------------------------------------------------------------------------
                | Global de-duplicate
                |--------------------------------------------------------------------------
                */

                if (
                    in_array(
                        $rule,
                        $ruleLines,
                        true
                    )
                ) {
                    continue;
                }

                $lines[] = $rule;
                $ruleLines[] = $rule;
            }
        }

        $content = '';

        if (!empty($lines)) {
            $content =
                implode(
                    PHP_EOL,
                    $lines
                )
                . PHP_EOL;
        }

        return [
            'domains' => $domains,

            /*
            | Semua baris file, termasuk:
            | # FACEBOOK
            | .facebook.com
            */
            'lines' => $lines,

            /*
            | Hanya rule domain, tanpa komentar.
            */
            'rules' => $ruleLines,

            'content' => $content,

            'domain_count' =>
                $domains->count(),

            'rule_count' =>
                count($ruleLines),

            'line_count' =>
                count($lines),
        ];
    }

    /**
     * Preview blacklist tanpa menulis file.
     */
    public function preview(): array
    {
        $blacklist =
            $this->buildBlacklist();

        return [
            'mode' =>
                config('squid.mode'),

            'path' =>
                $this->getBlacklistPath(),

            'domain_count' =>
                $blacklist['domain_count'],

            'rule_count' =>
                $blacklist['rule_count'],

            'line_count' =>
                $blacklist['line_count'],

            'lines' =>
                $blacklist['lines'],

            'rules' =>
                $blacklist['rules'],

            'content' =>
                $blacklist['content'],
        ];
    }

    /**
     * Sinkronisasi database blacklist_domains
     * ke file blacklist Squid.
     *
     * Service ini HANYA bertanggung jawab menulis file.
     * Status "synced" baru ditentukan oleh Controller setelah
     * Squid berhasil parse + reconfigure.
     */
    public function sync(): array
    {
        try {
            $blacklist =
                $this->buildBlacklist();

            $path =
                $this->getBlacklistPath();

            $directory =
                dirname($path);

            /*
            |--------------------------------------------------------------------------
            | Pastikan directory tersedia
            |--------------------------------------------------------------------------
            */

            if (!File::isDirectory($directory)) {
                if (
                    config('squid.mode')
                    === 'local'
                ) {
                    File::ensureDirectoryExists(
                        $directory
                    );
                } else {
                    throw new RuntimeException(
                        "Directory blacklist tidak ditemukan: {$directory}"
                    );
                }
            }

            /*
            |--------------------------------------------------------------------------
            | Production safety guard
            |--------------------------------------------------------------------------
            |
            | Jangan pernah mengosongkan blacklist.txt yang masih berisi rule
            | hanya karena database aktif mendadak menjadi 0.
            |
            */

            if (
                config('squid.mode')
                === 'production'
                &&
                $blacklist['rule_count']
                === 0
                &&
                File::exists($path)
            ) {
                $existing =
                    $this->extractRules(
                        (string) File::get(
                            $path
                        )
                    );

                if (!empty($existing)) {
                    throw new RuntimeException(
                        'Sinkronisasi dibatalkan: database aktif kosong '
                        . 'sementara blacklist.txt masih memiliki '
                        . count($existing)
                        . ' rule.'
                    );
                }
            }

            /*
            |--------------------------------------------------------------------------
            | Pastikan directory + file dapat ditulis
            |--------------------------------------------------------------------------
            */

            if (!is_writable($directory)) {
                throw new RuntimeException(
                    "Directory blacklist tidak dapat ditulis: {$directory}"
                );
            }

            if (
                File::exists($path)
                &&
                !is_writable($path)
            ) {
                throw new RuntimeException(
                    "File blacklist tidak dapat ditulis: {$path}"
                );
            }

            /*
            |--------------------------------------------------------------------------
            | Tulis blacklist dengan lock
            |--------------------------------------------------------------------------
            */

            $result =
                file_put_contents(
                    $path,
                    $blacklist['content'],
                    LOCK_EX
                );

            if ($result === false) {
                throw new RuntimeException(
                    "Gagal menulis blacklist ke: {$path}"
                );
            }

            /*
            |--------------------------------------------------------------------------
            | Verifikasi file setelah ditulis
            |--------------------------------------------------------------------------
            */

            $writtenContent =
                (string) File::get(
                    $path
                );

            $writtenRules =
                $this->extractRules(
                    $writtenContent
                );

            $expectedRules =
                collect(
                    $blacklist['rules']
                )
                    ->unique()
                    ->sort()
                    ->values()
                    ->all();

            if (
                $writtenRules
                !== $expectedRules
            ) {
                throw new RuntimeException(
                    'Verifikasi blacklist.txt gagal. '
                    . 'Expected '
                    . count($expectedRules)
                    . ' rule, file menghasilkan '
                    . count($writtenRules)
                    . ' rule.'
                );
            }

            return [
                'success' => true,

                'mode' =>
                    config('squid.mode'),

                'path' =>
                    $path,

                'domain_count' =>
                    $blacklist['domain_count'],

                'rule_count' =>
                    $blacklist['rule_count'],

                'line_count' =>
                    $blacklist['line_count'],

                'bytes_written' =>
                    (int) $result,

                'written_at' =>
                    now(),
            ];
        } catch (Throwable $e) {
            /*
            |--------------------------------------------------------------------------
            | Jangan ubah sync_status di service
            |--------------------------------------------------------------------------
            |
            | Controller yang menentukan Pending / Synced / Error setelah
            | hasil apply Squid diketahui.
            |
            */

            throw $e;
        }
    }

    /**
     * Membaca blacklist.txt yang sedang aktif.
     */
    public function readCurrentFile(): array
    {
        $path =
            $this->getBlacklistPath();

        if (!File::exists($path)) {
            return [
                'exists' => false,
                'path' => $path,
                'lines' => [],
                'content' => '',
            ];
        }

        $content =
            (string) File::get(
                $path
            );

        $lines =
            preg_split(
                '/\r\n|\r|\n/',
                $content
            )
            ?: [];

        $lines =
            collect($lines)
                ->map(
                    fn ($line) =>
                        trim(
                            (string) $line
                        )
                )
                ->filter(
                    fn ($line) =>
                        $line !== ''
                )
                ->values()
                ->all();

        return [
            'exists' => true,
            'path' => $path,
            'lines' => $lines,
            'content' => $content,
        ];
    }

    /**
     * Ambil hanya rule domain dari isi blacklist.txt.
     * Komentar # KATEGORI dan baris kosong diabaikan.
     */
    private function extractRules(
        string $content
    ): array {
        $lines =
            preg_split(
                '/\r\n|\r|\n/',
                $content
            )
            ?: [];

        return collect($lines)
            ->map(
                fn ($line) =>
                    trim(
                        (string) $line
                    )
            )
            ->filter(
                fn ($line) =>
                    $line !== ''
                    &&
                    !str_starts_with(
                        $line,
                        '#'
                    )
            )
            ->unique()
            ->sort()
            ->values()
            ->all();
    }

    /**
     * Normalisasi domain.
     */
    private function normalizeDomain(
        ?string $value
    ): ?string {
        if ($value === null) {
            return null;
        }

        $domain =
            strtolower(
                trim($value)
            );

        if ($domain === '') {
            return null;
        }

        /*
        |--------------------------------------------------------------------------
        | URL -> hostname
        |--------------------------------------------------------------------------
        */

        if (
            str_starts_with(
                $domain,
                'http://'
            )
            ||
            str_starts_with(
                $domain,
                'https://'
            )
        ) {
            $host =
                parse_url(
                    $domain,
                    PHP_URL_HOST
                );

            if (
                !is_string($host)
                ||
                trim($host) === ''
            ) {
                return null;
            }

            $domain =
                strtolower(
                    trim($host)
                );
        }

        /*
        |--------------------------------------------------------------------------
        | Hilangkan wildcard / titik depan
        |--------------------------------------------------------------------------
        */

        if (
            str_starts_with(
                $domain,
                '*.'
            )
        ) {
            $domain =
                substr(
                    $domain,
                    2
                );
        }

        $domain =
            ltrim(
                $domain,
                '.'
            );

        /*
        |--------------------------------------------------------------------------
        | Hapus path
        |--------------------------------------------------------------------------
        */

        if (
            str_contains(
                $domain,
                '/'
            )
        ) {
            $domain =
                explode(
                    '/',
                    $domain,
                    2
                )[0];
        }

        /*
        |--------------------------------------------------------------------------
        | Hapus port IPv4/hostname style
        |--------------------------------------------------------------------------
        */

        $domain =
            preg_replace(
                '/:\d+$/',
                '',
                $domain
            );

        $domain =
            trim(
                (string) $domain,
                ". \t\n\r\0\x0B"
            );

        if ($domain === '') {
            return null;
        }

        if (
            filter_var(
                $domain,
                FILTER_VALIDATE_DOMAIN,
                FILTER_FLAG_HOSTNAME
            )
            === false
        ) {
            return null;
        }

        return $domain;
    }
}
