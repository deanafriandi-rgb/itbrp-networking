<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Models\BlacklistDomain;
use App\Services\SquidBlacklistService;
use App\Services\SquidControlService;
use Illuminate\Http\Request;
use Illuminate\Validation\Rule;
use Throwable;

class BlacklistController extends Controller
{
    /**
     * Tampilkan halaman blacklist.
     */
    public function index(
        Request $request,
        SquidBlacklistService $blacklist,
        SquidControlService $control
    ) {
        $query = BlacklistDomain::query();

        if ($request->filled('search')) {
            $search = trim((string) $request->search);

            $query->where(function ($q) use ($search) {
                $q->where('domain', 'like', "%{$search}%")
                    ->orWhere('category', 'like', "%{$search}%")
                    ->orWhere('notes', 'like', "%{$search}%");
            });
        }

        if ($request->status === 'active') {
            $query->where('is_active', true);
        } elseif ($request->status === 'inactive') {
            $query->where('is_active', false);
        }

        if ($request->filled('sync_status')) {
            $query->where(
                'sync_status',
                $request->sync_status
            );
        }

        $domains = $query
            ->orderByDesc('is_active')
            ->orderBy('domain')
            ->paginate(20)
            ->withQueryString();

        $summary = [
            'total' => BlacklistDomain::count(),

            'active' => BlacklistDomain::where(
                'is_active',
                true
            )->count(),

            'inactive' => BlacklistDomain::where(
                'is_active',
                false
            )->count(),

            'synced' => BlacklistDomain::where(
                'sync_status',
                BlacklistDomain::SYNC_SYNCED
            )->count(),

            'pending' => BlacklistDomain::where(
                'sync_status',
                BlacklistDomain::SYNC_PENDING
            )->count(),

            'error' => BlacklistDomain::where(
                'sync_status',
                BlacklistDomain::SYNC_ERROR
            )->count(),
        ];

        $currentFile = $blacklist->readCurrentFile();
        $controlStatus = $control->status();

        return view(
            'pages.admin.blacklist',
            compact(
                'domains',
                'summary',
                'currentFile',
                'controlStatus'
            )
        );
    }

    /**
     * Tambah domain blacklist.
     */
    public function store(
        Request $request,
        SquidBlacklistService $blacklist,
        SquidControlService $control
    ) {
        $request->merge([
            'domain' => $this->normalizeDomainInput(
                (string) $request->input('domain', '')
            ),
        ]);

        $validated = $this->validateDomain($request);

        BlacklistDomain::create([
            'domain' => $validated['domain'],

            'category' =>
                $validated['category']
                ?? null,

            'include_subdomains' =>
                $request->boolean(
                    'include_subdomains'
                ),

            'is_active' =>
                $request->boolean(
                    'is_active'
                ),

            'source' => 'manual',

            'sync_status' =>
                BlacklistDomain::SYNC_PENDING,

            'synced_at' => null,

            'notes' =>
                $validated['notes']
                ?? null,
        ]);

        return $this->syncAndRedirect(
            $blacklist,
            $control,
            'Domain berhasil ditambahkan.'
        );
    }

    /**
     * Update domain blacklist.
     */
    public function update(
        Request $request,
        BlacklistDomain $blacklistDomain,
        SquidBlacklistService $blacklist,
        SquidControlService $control
    ) {
        $request->merge([
            'domain' => $this->normalizeDomainInput(
                (string) $request->input('domain', '')
            ),
        ]);

        $validated = $this->validateDomain(
            $request,
            $blacklistDomain
        );

        $blacklistDomain->update([
            'domain' => $validated['domain'],

            'category' =>
                $validated['category']
                ?? null,

            'include_subdomains' =>
                $request->boolean(
                    'include_subdomains'
                ),

            'is_active' =>
                $request->boolean(
                    'is_active'
                ),

            'sync_status' =>
                BlacklistDomain::SYNC_PENDING,

            'synced_at' => null,

            'notes' =>
                $validated['notes']
                ?? null,
        ]);

        return $this->syncAndRedirect(
            $blacklist,
            $control,
            'Domain berhasil diperbarui.'
        );
    }

    /**
     * Aktif / nonaktif domain.
     */
    public function toggle(
        BlacklistDomain $blacklistDomain,
        SquidBlacklistService $blacklist,
        SquidControlService $control
    ) {
        /*
        |--------------------------------------------------------------------------
        | Safety: jangan sampai domain aktif terakhir hilang diam-diam
        |--------------------------------------------------------------------------
        */

        if (
            $blacklistDomain->is_active
            &&
            BlacklistDomain::where(
                'is_active',
                true
            )->count() <= 1
        ) {
            return redirect()
                ->route('admin.blacklist.index')
                ->with(
                    'warning',
                    'Domain aktif terakhir tidak dinonaktifkan. '
                    . 'Pengaman mencegah blacklist.txt menjadi kosong.'
                );
        }

        $blacklistDomain->update([
            'is_active' =>
                !$blacklistDomain->is_active,

            'sync_status' =>
                BlacklistDomain::SYNC_PENDING,

            'synced_at' => null,
        ]);

        return $this->syncAndRedirect(
            $blacklist,
            $control,

            $blacklistDomain->is_active
                ? 'Domain berhasil diaktifkan.'
                : 'Domain berhasil dinonaktifkan.'
        );
    }

    /**
     * Hapus domain.
     */
    public function destroy(
        BlacklistDomain $blacklistDomain,
        SquidBlacklistService $blacklist,
        SquidControlService $control
    ) {
        /*
        |--------------------------------------------------------------------------
        | Safety: domain aktif terakhir tidak boleh terhapus dari UI
        |--------------------------------------------------------------------------
        */

        if (
            $blacklistDomain->is_active
            &&
            BlacklistDomain::where(
                'is_active',
                true
            )->count() <= 1
        ) {
            return redirect()
                ->route('admin.blacklist.index')
                ->with(
                    'warning',
                    'Domain aktif terakhir tidak dihapus. '
                    . 'Pengaman mencegah blacklist.txt menjadi kosong.'
                );
        }

        $domain = $blacklistDomain->domain;

        $blacklistDomain->delete();

        return $this->syncAndRedirect(
            $blacklist,
            $control,
            "Domain {$domain} berhasil dihapus."
        );
    }

    /**
     * Sinkronisasi manual.
     */
    public function sync(
        SquidBlacklistService $blacklist,
        SquidControlService $control
    ) {
        /*
        |--------------------------------------------------------------------------
        | Manual retry = tandai domain aktif sebagai pending
        |--------------------------------------------------------------------------
        */

        BlacklistDomain::where(
            'is_active',
            true
        )->update([
            'sync_status' =>
                BlacklistDomain::SYNC_PENDING,

            'synced_at' => null,
        ]);

        return $this->syncAndRedirect(
            $blacklist,
            $control,
            'Blacklist berhasil disinkronkan.'
        );
    }

    /**
     * Validasi input domain.
     */
    private function validateDomain(
        Request $request,
        ?BlacklistDomain $domain = null
    ): array {
        return $request->validate([
            'domain' => [
                'required',
                'string',
                'max:255',

                Rule::unique(
                    'blacklist_domains',
                    'domain'
                )->ignore(
                    $domain?->id
                ),

                function (
                    $attribute,
                    $value,
                    $fail
                ) {
                    $value =
                        $this->normalizeDomainInput(
                            (string) $value
                        );

                    if (
                        str_contains(
                            $value,
                            '://'
                        )
                        ||
                        str_contains(
                            $value,
                            '/'
                        )
                    ) {
                        $fail(
                            'Masukkan domain saja, contoh facebook.com tanpa http:// atau path.'
                        );

                        return;
                    }

                    if (
                        filter_var(
                            $value,
                            FILTER_VALIDATE_DOMAIN,
                            FILTER_FLAG_HOSTNAME
                        )
                        === false
                    ) {
                        $fail(
                            'Format domain tidak valid.'
                        );
                    }
                },
            ],

            'category' => [
                'nullable',
                'string',
                'max:100',
            ],

            'notes' => [
                'nullable',
                'string',
                'max:1000',
            ],
        ]);
    }

    /**
     * DB -> blacklist.txt -> validasi isi -> Squid.
     *
     * Safety:
     * - DB aktif 0 tidak boleh menghapus file yang masih berisi rule.
     * - Hasil generate harus sama persis dengan rule aktif di database.
     * - Jika apply gagal, file sebelum sync dikembalikan.
     */
    private function syncAndRedirect(
        SquidBlacklistService $blacklist,
        SquidControlService $control,
        string $successMessage
    ) {
        $before = null;

        try {
            /*
            |--------------------------------------------------------------------------
            | Snapshot file sebelum sync
            |--------------------------------------------------------------------------
            */

            $before =
                $blacklist->readCurrentFile();

            $beforeRules =
                $this->extractRulesFromFile(
                    $before
                );

            $expectedRules =
                $this->expectedRulesFromDatabase();

            /*
            |--------------------------------------------------------------------------
            | Guard utama: DB kosong tidak boleh menghapus file aktif
            |--------------------------------------------------------------------------
            */

            if (
                count($expectedRules) === 0
                &&
                count($beforeRules) > 0
            ) {
                return redirect()
                    ->route(
                        'admin.blacklist.index'
                    )
                    ->with(
                        'warning',
                        'Sinkronisasi dibatalkan. '
                        . 'Database tidak memiliki domain aktif, '
                        . 'tetapi blacklist.txt masih memiliki '
                        . count($beforeRules)
                        . ' rule. File Squid tidak diubah.'
                    );
            }

            /*
            |--------------------------------------------------------------------------
            | Database -> blacklist.txt
            |--------------------------------------------------------------------------
            */

            $blacklist->sync();

            /*
            |--------------------------------------------------------------------------
            | Validasi hasil file
            |--------------------------------------------------------------------------
            */

            $after =
                $blacklist->readCurrentFile();

            $afterRules =
                $this->extractRulesFromFile(
                    $after
                );

            if ($afterRules !== $expectedRules) {
                $this->restoreBlacklistSnapshot(
                    $before,
                    $control
                );

                BlacklistDomain::where(
                    'is_active',
                    true
                )->update([
                    'sync_status' =>
                        BlacklistDomain::SYNC_ERROR,
                ]);

                return redirect()
                    ->route(
                        'admin.blacklist.index'
                    )
                    ->with(
                        'warning',
                        'Sinkronisasi dibatalkan karena hasil blacklist.txt '
                        . 'tidak sama dengan database. '
                        . 'Expected '
                        . count($expectedRules)
                        . ' rule, tetapi file menghasilkan '
                        . count($afterRules)
                        . ' rule. File sebelumnya sudah dipulihkan.'
                    );
            }

            /*
            |--------------------------------------------------------------------------
            | blacklist.txt -> Squid
            |--------------------------------------------------------------------------
            */

            $apply =
                $control->apply();

            /*
            |--------------------------------------------------------------------------
            | LOCAL MODE
            |--------------------------------------------------------------------------
            */

            if (
                config('squid.mode')
                === 'local'
            ) {
                $this->markAllSynced();

                return redirect()
                    ->route(
                        'admin.blacklist.index'
                    )
                    ->with(
                        'success',
                        $successMessage
                        . ' File blacklist lokal sudah diperbarui.'
                    );
            }

            /*
            |--------------------------------------------------------------------------
            | PRODUCTION SUCCESS
            |--------------------------------------------------------------------------
            */

            if (
                $apply['success']
                ?? false
            ) {
                $this->markAllSynced();

                return redirect()
                    ->route(
                        'admin.blacklist.index'
                    )
                    ->with(
                        'success',
                        $successMessage
                        . ' Squid berhasil direconfigure.'
                    );
            }

            /*
            |--------------------------------------------------------------------------
            | PRODUCTION APPLY FAILED -> ROLLBACK FILE
            |--------------------------------------------------------------------------
            */

            $this->restoreBlacklistSnapshot(
                $before,
                $control
            );

            BlacklistDomain::where(
                'is_active',
                true
            )->update([
                'sync_status' =>
                    BlacklistDomain::SYNC_ERROR,
            ]);

            return redirect()
                ->route(
                    'admin.blacklist.index'
                )
                ->with(
                    'warning',
                    $successMessage
                    . ' dibatalkan karena Squid gagal menerapkan konfigurasi. '
                    . 'blacklist.txt sebelumnya sudah dipulihkan. '
                    . (
                        $apply['message']
                        ?? ''
                    )
                );
        } catch (Throwable $e) {
            /*
            |--------------------------------------------------------------------------
            | Exception -> usahakan rollback
            |--------------------------------------------------------------------------
            */

            if (is_array($before)) {
                try {
                    $this->restoreBlacklistSnapshot(
                        $before,
                        $control
                    );
                } catch (Throwable) {
                    // Jangan menutupi error utama.
                }
            }

            BlacklistDomain::where(
                'sync_status',
                BlacklistDomain::SYNC_PENDING
            )->update([
                'sync_status' =>
                    BlacklistDomain::SYNC_ERROR,
            ]);

            return redirect()
                ->route(
                    'admin.blacklist.index'
                )
                ->withInput()
                ->with(
                    'error',
                    'Sinkronisasi blacklist gagal: '
                    . $e->getMessage()
                );
        }
    }

    /**
     * Bentuk rule yang seharusnya ada berdasarkan database aktif.
     *
     * include_subdomains=true:
     * facebook.com -> .facebook.com
     *
     * include_subdomains=false:
     * facebook.com -> facebook.com
     */
    private function expectedRulesFromDatabase(): array
    {
        return BlacklistDomain::query()
            ->where(
                'is_active',
                true
            )
            ->orderBy('domain')
            ->get([
                'domain',
                'include_subdomains',
            ])
            ->map(function ($domain) {
                $name =
                    $this->normalizeDomainInput(
                        (string) $domain->domain
                    );

                return $domain->include_subdomains
                    ? '.' . $name
                    : $name;
            })
            ->filter()
            ->unique()
            ->sort()
            ->values()
            ->all();
    }

    /**
     * Ambil hanya rule domain dari readCurrentFile().
     * Komentar kategori (# FACEBOOK) dan baris kosong diabaikan.
     */
    private function extractRulesFromFile(
        array $file
    ): array {
        return collect(
            $file['lines']
            ?? []
        )
            ->map(
                fn ($line) =>
                    trim((string) $line)
            )
            ->filter(
                fn ($line) =>
                    $line !== ''
                    &&
                    !str_starts_with(
                        $line,
                        '#'
                    )
            )
            ->unique()
            ->sort()
            ->values()
            ->all();
    }

    /**
     * Restore blacklist.txt dari snapshot sebelum sinkronisasi.
     */
    private function restoreBlacklistSnapshot(
        array $snapshot,
        SquidControlService $control
    ): void {
        $status =
            $control->status();

        $path =
            $status['blacklist_file']
            ?? config(
                'squid.blacklist_file'
            );

        if (
            !is_string($path)
            ||
            trim($path) === ''
        ) {
            throw new \RuntimeException(
                'Path blacklist.txt tidak ditemukan.'
            );
        }

        $lines =
            $snapshot['lines']
            ?? [];

        $content =
            implode(
                PHP_EOL,
                array_map(
                    fn ($line) =>
                        rtrim(
                            (string) $line,
                            "\r\n"
                        ),
                    $lines
                )
            );

        if ($content !== '') {
            $content .= PHP_EOL;
        }

        $written =
            file_put_contents(
                $path,
                $content,
                LOCK_EX
            );

        if ($written === false) {
            throw new \RuntimeException(
                'Rollback blacklist.txt gagal ditulis.'
            );
        }

        /*
        |--------------------------------------------------------------------------
        | Best effort: aktifkan kembali konfigurasi lama
        |--------------------------------------------------------------------------
        */

        if (
            config('squid.mode')
            === 'production'
        ) {
            $control->apply();
        }
    }

    /**
     * Tandai seluruh record sesuai kondisi file yang berhasil diterapkan.
     */
    private function markAllSynced(): void
    {
        BlacklistDomain::query()
            ->update([
                'sync_status' =>
                    BlacklistDomain::SYNC_SYNCED,

                'synced_at' => now(),
            ]);
    }

    /**
     * Normalisasi input domain.
     */
    private function normalizeDomainInput(
        string $value
    ): string {
        $value =
            strtolower(
                trim($value)
            );

        if (
            str_starts_with(
                $value,
                '*.'
            )
        ) {
            $value =
                substr(
                    $value,
                    2
                );
        }

        return ltrim(
            $value,
            '.'
        );
    }
}
